# Database
DATABASE_URL=postgresql://tripsync:tripsync_dev@localhost:5432/tripsync

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=4000
NODE_ENV=development

# Auth (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here
AUTH_TRUST_HOST=true

# Backend API URL (used by Next.js to call Express server)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Map basemap tiles (optional). Defaults to keyless OpenStreetMap standard tiles.
# To use a warmer keyed style (e.g. MapTiler / Stadia), set a tile URL that
# embeds your API key, plus the matching attribution. {s}/{z}/{x}/{y}{r} tokens
# are substituted by Leaflet.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/voyager/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# NEXT_PUBLIC_MAP_TILE_SUBDOMAINS=abc

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Geocoding (Nominatim / OpenStreetMap)
# Only the server calls Nominatim. Their usage policy requires a User-Agent that
# identifies the app with real contact details — set these before deploying, or
# you risk being blocked. See https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT=TripSync/1.0 (contact: you@example.com)
GEOCODE_REFERER=http://localhost:3000
GEOCODE_CONTACT_EMAIL=
# Optional: restrict location search to specific countries (ISO 3166-1 alpha-2,
# comma-separated), e.g. "in" or "in,np,bt". Leave empty for worldwide search.
GEOCODE_COUNTRY_CODES=
